{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/leiboss/dsh-voiceover/schemas/manifest.schema.json",
  "title": "VoiceoverManifest",
  "description": "有声项目清单。第三方消费方（daemon、导出器、审计）以此为准；路径一律相对项目根。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "createdAt", "capability", "engine", "promptVersion", "source", "chapters", "totals", "warnings"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "projectId": { "type": "string", "pattern": "^[0-9a-f]{8,24}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "maxLength": 60 },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llm", "network", "wordBoundaries", "timingQuality"],
      "properties": {
        "llm": { "type": "boolean", "description": "改写链路是否可用；false 表示按原文直读。" },
        "network": { "type": "boolean", "description": "Edge 端点是否可达（含经代理可达）。" },
        "wordBoundaries": { "type": "boolean", "description": "引擎是否返回词边界。" },
        "timingQuality": { "type": "string", "enum": ["exact", "estimated", "none"] }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "voice", "rate"],
      "properties": {
        "name": { "type": "string", "enum": ["edge-js", "edge-py", "sapi", "speechSynthesis"] },
        "version": { "type": "string" },
        "voice": { "type": "string" },
        "rate": { "type": "string", "pattern": "^[+-][0-9]{1,3}%$" },
        "viaProxy": { "type": "boolean" }
      }
    },
    "promptVersion": { "type": "string", "pattern": "^p[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "chars"],
      "properties": {
        "path": { "type": "string" },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "chars": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "enum": ["md", "txt", "pdf", "docx", "html"] }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "chars", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^ch-[0-9]{2,3}$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "maxLength": 40 },
          "chars": { "type": "integer", "minimum": 1 },
          "sourceRange": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          },
          "status": {
            "type": "string",
            "enum": ["queued", "adapted", "marked", "audited", "synthesized", "timed", "done", "failed"]
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "durationMs", "timingQuality"],
            "properties": {
              "path": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 1 },
              "durationMs": { "type": "integer", "minimum": 1 },
              "timingQuality": { "type": "string", "enum": ["exact", "estimated"] },
              "format": { "type": "string", "enum": ["mp3", "wav"] }
            }
          },
          "subtitles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "units"],
            "properties": {
              "path": { "type": "string" },
              "units": { "type": "integer", "minimum": 0 },
              "timingQuality": { "type": "string", "enum": ["exact", "estimated"] }
            }
          },
          "script": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "hash"],
            "properties": {
              "path": { "type": "string" },
              "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters", "chars", "audioMs", "bytes"],
      "properties": {
        "chapters": { "type": "integer", "minimum": 0 },
        "chars": { "type": "integer", "minimum": 0 },
        "audioMs": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    }
  }
}
