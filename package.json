{
  "name": "dsh-tts",
  "version": "0.2.0",
  "description": "DSH tool plugin that turns text into a saved audio file with Edge-TTS, including web playback, long-text chunking, and fallbacks.",
  "license": "MIT",
  "author": "LeiBoss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeiBoss/dsh-tts.git"
  },
  "bugs": {
    "url": "https://github.com/LeiBoss/dsh-tts/issues"
  },
  "keywords": [
    "dsh-plugin",
    "tts",
    "edge-tts",
    "text-to-speech",
    "audio"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:integration": "node test/integration.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
